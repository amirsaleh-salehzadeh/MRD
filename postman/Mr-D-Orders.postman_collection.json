  "item": [
    {
      "name": "Automated API checks",
      "description": "Run this folder in order with the API, database, and worker running.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API is live', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Database is ready', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('ready');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Load sample product prices",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sample products exist and prices can be used to verify server totals', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const products = pm.response.json();",
                  "    const banana = products.find(p => p.sku === 'BAN-001');",
                  "    const apple = products.find(p => p.sku === 'APL-003');",
                  "    pm.expect(banana, 'BAN-001 must be seeded').to.exist;",
                  "    pm.expect(apple, 'APL-003 must be seeded').to.exist;",
                  "    pm.collectionVariables.set('expectedTotal', banana.price_cents + apple.price_cents);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_ref\": \"{{orderRef}}\",\n  \"customer_id\": \"postman-customer\",\n  \"items\": [\n    {\n      \"sku\": \"BAN-001\",\n      \"qty\": 1\n    },\n    {\n      \"sku\": \"APL-003\",\n      \"qty\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('orderRef', 'postman-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.collectionVariables.set('reportDate', new Date().toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order accepted; total is calculated from database prices', function () {",
                  "    pm.response.to.have.status(202);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.order_ref).to.eql(pm.collectionVariables.get('orderRef'));",
                  "    pm.expect(body.total_cents).to.eql(Number(pm.collectionVariables.get('expectedTotal')));",
                  "    pm.expect(body.status).to.be.oneOf(['PENDING_STOCK', 'STOCK_UPDATED']);",
                  "    pm.expect(body.duplicate).to.eql(false);",
                  "    pm.collectionVariables.set('orderId', body.order_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeat identical order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_ref\": \"{{orderRef}}\",\n  \"customer_id\": \"postman-customer\",\n  \"items\": [\n    {\n      \"sku\": \"BAN-001\",\n      \"qty\": 1\n    },\n    {\n      \"sku\": \"APL-003\",\n      \"qty\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Identical retry returns the same order without duplication', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.duplicate).to.eql(true);",
                  "    pm.expect(body.order_id).to.eql(pm.collectionVariables.get('orderId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Changed duplicate payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_ref\": \"{{orderRef}}\",\n  \"customer_id\": \"postman-customer\",\n  \"items\": [\n    {\n      \"sku\": \"BAN-001\",\n      \"qty\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Changed payload with the same reference returns conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order lookup returns the saved item and price snapshots', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('orderId'));",
                  "    pm.expect(body.order_ref).to.eql(pm.collectionVariables.get('orderRef'));",
                  "    pm.expect(body.items).to.have.length(2);",
                  "    pm.expect(body.status).to.be.oneOf(['PENDING_STOCK', 'STOCK_UPDATED']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product list is returned in SKU order', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const products = pm.response.json();",
                  "    pm.expect(products).to.be.an('array').and.not.empty;",
                  "    pm.expect(products.map(p => p.sku)).to.eql([...products.map(p => p.sku)].sort());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read BAN-001 product",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/BAN-001"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Product detail includes price and stock', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.sku).to.eql('BAN-001');",
                  "    pm.expect(body.price_cents).to.be.a('number');",
                  "    pm.expect(body.stock).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read BAN-001 stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/BAN-001/stock"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock lookup returns a nonnegative integer', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.sku).to.eql('BAN-001');",
                  "    pm.expect(body.stock).to.be.a('number').and.at.least(0);",
                  "});"
                ]
              }
            }
          ]
        },
