    {
      "name": "Manual scenario: pause worker and queue order",
      "description": "Run this folder separately after `docker compose stop worker`. Do not run the full collection while the worker is stopped. It records stock, submits one BAN-001 order, and verifies the order stays pending while stock is unchanged.",
      "item": [
        {
          "name": "Record BAN-001 stock before pause",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/BAN-001/stock"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Capture starting stock', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.collectionVariables.set('outageStockBefore', pm.response.json().stock);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order while worker is stopped",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_ref\": \"{{outageOrderRef}}\",\n  \"customer_id\": \"postman-outage-customer\",\n  \"items\": [\n    {\n      \"sku\": \"BAN-001\",\n      \"qty\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('outageOrderRef', 'postman-outage-' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order is accepted but remains pending while worker is stopped', function () {",
                  "    pm.response.to.have.status(202);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('PENDING_STOCK');",
                  "    pm.collectionVariables.set('outageOrderId', body.order_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm stock stays unchanged during pause",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products/BAN-001/stock"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stock has not changed while the event waits', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().stock).to.eql(Number(pm.collectionVariables.get('outageStockBefore')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm order is pending during pause",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/orders/{{outageOrderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order remains pending until the worker resumes', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('PENDING_STOCK');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
