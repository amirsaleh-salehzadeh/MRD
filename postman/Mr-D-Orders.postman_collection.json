                  "    const body = pm.response.json();",
                  "    pm.expect(body.items).to.be.an('array').and.not.empty;",
                  "    pm.expect(body).to.have.property('next_cursor');",
                  "    const event = body.items[0];",
                  "    pm.collectionVariables.set('eventId', event.event_id);",
                  "    pm.collectionVariables.set('eventCursor', event.event_id);",
                  "});"
                ]
